# UAE
*.uaem

# Large / regenerable artifacts
# (gitignore has no inline-comment syntax -- a trailing "# ..." on a pattern line
# is taken as literal glob text and matches nothing, so comments go on their own line)
*.zip

# Game ROM and image artifacts — kept LOCAL only, never committed.
# rof.xex is the copyrighted source binary; PNGs are screenshots / comparison
# captures. Purged from history 2026-06-02; keep them out of the repo for good.
*.xex
*.png

# Generated, regenerable from rof.xex via the tools
disasm/rof_mem.bin
disasm/listing.txt

# Build output
build/
*.o
*.rep
*.lock

# Generated C (regenerate with: make gen)
src/gen/rof_gen.c
src/gen/rof_decl.h

# OS
.DS_Store
src/**/*.o

# Ghidra install + project and local probe scratch under tools/ (never commit)
# tools/ghidra has no trailing slash: it's a symlink to a shared install
# (~/.local/share/ghidra), and a trailing-slash gitignore pattern only matches a
# real directory, not a symlink to one.
tools/ghidra
tools/ghidra-proj/
tools/__pycache__/
tools/live_*.sh

# Local probe/debug scratch — savestates, RAM dumps, ad-hoc probe scripts, spike
# experiments. Kept LOCAL only (never committed); regenerable / disposable.
/tmp/
/a800dumps/
/amiga-spike/
*.a8s
*.dat
*bars_active.bin*
amiga/*_probe.sh
amiga/sample.sh
amiga/trace_blit*.sh
amiga/wing_run.sh
amiga/wing_probe.gdb
amiga/assets/attract.raw
amiga/assets/attract_pal.h
amiga/RoF-asm.exe
amiga/RoF-cmixer.exe
